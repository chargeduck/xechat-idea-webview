########## server配置 ##########
[SERVER]
# 端口
port = 1024
# 是否开启WS协议
enableWS = true

########## 敏感词配置 ##########
[SENSITIVE_WORD]
# 词库文件路径（为空则不启用敏感词过滤）
file = ${SW_FILE}

########## 天气查询配置 ##########
[WEATHER]
# 和风天气 api key（为空则不启用天气查询）
key = ${WEATHER_KEY}

########## 翻译配置 ##########
[TRANSLATION]
# 百度翻译 app id
appId = ${BD_APP_ID}
# 百度翻译 app key
appKey = ${BD_APP_KEY}

########## ip查询配置 ##########
[IP_SEARCH]
# ip2region 离线地址库
# 下载地址：https://gitee.com/lionsoul/ip2region/tree/master/data
ip2Region_path = /opt/apps/xechat-server/data/db/ip2region.xdb

########## 管理员配置 ##########
[ADMIN]
# 管理员令牌
token = ${TOKEN}
